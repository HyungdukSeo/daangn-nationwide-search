{
  "version": 2,
  "regions": ["icn1"],
  "functions": {
    "api/search.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "daangn-nationwide-search-lby3.vercel.app"
        }
      ],
      "destination": "https://daangn-nationwide-search-smoky.vercel.app/:path*",
      "permanent": true
    }
  ]
}
